# 公开空值模板；复制为.env后填写密码/Key，禁止将真实值写入本模板。
# Oracle运行账号：不是SYS/SYSTEM，也不是网页登录账号。
DB_USER=FACE_RUNTIME
DB_PASSWORD=
DB_CONNECT_STRING=127.0.0.1:1521/FREEPDB1
DB_SCHEMA=FACE_APP

# 本机服务；通常不用修改
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173

# 网页管理员；密码至少6字符，建议使用独立长密码。
# 重启后端会同步此账号密码并使旧登录会话失效。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 百度OCR：同一应用的API Key和Secret Key；PDF/图片识别需要。
BAIDU_AK=
BAIDU_SK=
BAIDU_OCR_ENDPOINT=accurate_basic

# DeepSeek：简历分析/简历出题/评分需要；可先留空。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_INPUT_CHARS=80000

UPLOAD_MAX_MB=4
PDF_MAX_PAGES=10
AUTH_TTL_HOURS=12
